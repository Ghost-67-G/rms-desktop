{
  "name": "rms-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant Management System desktop app with managed local services",
  "homepage": "https://example.com/rms-desktop",
  "author": {
    "name": "Ayan Naseer",
    "email": "ayannaseerg67@gmail.com"
  },
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently -k -n FRONTEND,BACKEND,ELECTRON -c magenta,cyan,green \"bun run --cwd ../frontend dev -- --host 127.0.0.1 --port 5173\" \"RMS_RUNTIME=desktop bun run --cwd ../backend dev\" \"wait-on tcp:127.0.0.1:5173 http://127.0.0.1:8080/api/health && electron .\"",
    "start": "electron .",
    "build:frontend": "bun run --cwd ../frontend build",
    "build:backend": "bun install --cwd ../backend --production --ignore-scripts",
    "clean:release": "node -e \"const fs=require('fs');const path=require('path');const dir='release';if(fs.existsSync(dir)){for(const f of fs.readdirSync(dir)){if(/\\.deb$|\\.AppImage$|^latest.*\\.yml$/.test(f)) fs.rmSync(path.join(dir,f),{force:true});}}\"",
    "dist": "bun run clean:release && bun run build:frontend && bun run build:backend && electron-builder",
    "dist:linux": "bun run clean:release && bun run build:frontend && bun run build:backend && electron-builder --linux AppImage deb",
    "dist:linux:deb": "bun run clean:release && bun run build:frontend && bun run build:backend && electron-builder --linux deb",
    "dist:win": "bun run clean:release && bun run build:frontend && bun run build:backend && electron-builder --win nsis"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.rms.desktop",
    "productName": "RMSDesktop",
    "artifactName": "RMS-Desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../backend/src",
        "to": "backend/src"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "vendor/mongodb",
        "to": "mongodb"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.svg",
      "executableName": "rms-desktop",
      "category": "Office",
      "description": "Offline-first RMS desktop app with managed local MongoDB storage",
      "desktop": {
        "Name": "RMS Desktop",
        "Comment": "Restaurant Management System",
        "StartupWMClass": "RMS Desktop"
      },
      "maintainer": "Ayan Naseer <ayannaseerg67@gmail.com>"
    },
    "deb": {
      "synopsis": "Restaurant Management System desktop app",
      "priority": "optional"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RMS Desktop"
    }
  }
}
